{
  "name": "japanese-invoice-workflow",
  "version": "0.1.0",
  "description": "AI-assisted Japanese invoice processing with validation, approval workflow, row-level security and Stripe billing",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait",
    "invoices:generate": "tsx scripts/generate-invoices.ts",
    "eval": "tsx --env-file=.env.local scripts/eval.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "pretest:e2e": "node scripts/copy-pdf-worker.mjs",
    "org:create": "tsx --env-file=.env.local scripts/create-org.ts",
    "db:seed-demo": "tsx --env-file=.env.local scripts/seed-live-demo.ts",
    "eval:pipeline": "EXTRACTION_PROVIDER=fixture tsx scripts/eval.ts",
    "fixtures:build": "tsx scripts/build-demo-fixtures.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource/zen-maru-gothic": "5.3.1",
    "ai": "^7.0.153",
    "lucide-react": "1.61.0",
    "next": "^16.4.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
