# demo: in-process PostgreSQL (PGlite) seeded with fictional data; no API key needed.
# live: your own PostgreSQL and your own AI provider.
APP_MODE=demo

# --- live mode ---
# The exact origin people open in the browser. Used for the same-origin check,
# the Secure cookie flag and the Stripe return URLs. Use https in production.
APP_ORIGIN=http://127.0.0.1:3000
# The app must connect as a non-superuser login role that is a member of app_user
# and owns no tables (docker compose creates invoice_app for local use).
DATABASE_URL=postgresql://invoice_app:invoice_local_only@127.0.0.1:54325/invoices
ADMIN_DATABASE_URL=postgresql://postgres:postgres_local_only@127.0.0.1:54325/invoices
# claude (PDF and images) or codex (images, uses your ChatGPT login via Codex CLI)
EXTRACTION_PROVIDER=claude
ANTHROPIC_API_KEY=
# A Claude model ID available to your account
ANTHROPIC_MODEL=
CODEX_MODEL=
CODEX_EFFORT=auto

# --- optional: Stripe (test mode keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
